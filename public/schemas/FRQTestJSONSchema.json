{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "FRQ"
    },
    "comment": {
      "type": "string"
    },
    "questions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "poetry",
              "prose",
              "open"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "passage": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "attribution": {
                "type": "string"
              },
              "footnotes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "lineNumbers": {
                "type": "boolean"
              }
            },
            "required": [
              "text",
              "lineNumbers"
            ],
            "additionalProperties": false
          },
          "textList": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "type",
          "prompt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "type",
    "questions"
  ],
  "additionalProperties": false
}